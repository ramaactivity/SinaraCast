# Two separate places — don't mix them up:

# ============================================================
# (1) LOCAL FILE — copy to .env.local. Used by publish.mjs only.
# ============================================================
META_GRAPH_VERSION=v25.0
IG_USER_ID=
IG_ACCESS_TOKEN=
IMAGE_URL=https://YOUR-APP.vercel.app/test-story.jpg

# ============================================================
# (2) VERCEL DEPLOYMENT ENV — set in Vercel (Project > Settings >
#     Environment Variables), NOT in any local file. The OAuth
#     routes (/connect/*) run on Vercel and read these:
# ============================================================
#   META_APP_ID=931329016603828
#   META_APP_SECRET=********           <- only on Vercel; never a local file or chat
#   META_REDIRECT_URI=https://YOUR-APP.vercel.app/connect/callback
#   META_GRAPH_VERSION=v25.0
#
#   --- TikTok spike (/connect/tiktok/* + /api/tiktok-test) ---
#   TIKTOK_CLIENT_KEY=********
#   TIKTOK_CLIENT_SECRET=********      <- only on Vercel; never a local file or chat
#   TIKTOK_REDIRECT_URI=https://YOUR-APP.vercel.app/connect/tiktok/callback
#   (reuses CRON_SECRET as the OAuth state HMAC key, same as Instagram)
